%%{init: {"flowchart": {"htmlLabels": true, "wrappingWidth": 600, "nodeSpacing": 40, "rankSpacing": 50}}}%%
flowchart TD
    scan["HdfsScanNode -> DiskIoMgr I/O thread -> ScanRange::DoRead"]
    sel{"s3a:// and<br/>native reader on?"}
    hdfs["HdfsFileReader<br/>libhdfs, JVM, Hadoop S3A"]
    reader["S3NativeFileReader::ReadFromPos"]
    size{"length known<br/>and &lt;= 2 MiB?"}
    whole["Whole file<br/>one GET on the first read, one cache entry"]
    blocks["Blocks of --s3_native_block_size (128 KB)<br/>hits copied from memory<br/>each run of missing blocks = one ranged GET"]

    subgraph ram["S3NativeFileCache - RAM, under --mem_limit"]
        direction TB
        shards["Up to 16 shards by hash of bucket/key@mtime<br/>and block group (64 blocks = 8 MB)<br/>whole files stay in the shard of their key<br/>each: mutex, entries, LRU segments, read-frequency counters"]
        segs["Window (50%) -> W-TinyLFU admission -> probation / protected (80%) SLRU"]
        mem["Elastic memory: 256 MB always kept, up to 4 GiB borrowed from free query memory"]
        shards --- segs --- mem
    end

    disk[("Remote data cache on local disk<br/>--data_cache, optional second tier")]
    s3["aws-sdk-cpp S3Client<br/>ranged GET, connection pool, TLS (OpenSSL)"]
    ozone[("S3 endpoint: HAProxy -> Ozone S3 gateways")]

    scan --> sel
    sel -- no --> hdfs
    sel -- yes --> reader
    reader --> size
    size -- yes --> whole
    size -- no --> blocks
    whole --> ram
    blocks --> ram
    ram -- "not in RAM cache" --> disk
    disk -- "not on disk" --> s3
    s3 --> ozone
    s3 -. "fetched data" .-> ram
    s3 -. "write on fetch" .-> disk
