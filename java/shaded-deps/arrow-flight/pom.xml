<!-- Arrow Flight SQL (server and client) for the Flight SQL endpoint of the coordinator
     (org.apache.impala.service.flight). The impalad classpath already carries other
     versions of gRPC, netty, protobuf-java, Guava and Jackson, so they are bundled and
     relocated here. Arrow itself is not on the classpath and keeps its packages.
     netty-tcnative (BoringSSL natives) is left out: TLS uses the JDK provider. -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                      http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <parent>
    <groupId>org.apache.impala</groupId>
    <artifactId>impala-parent</artifactId>
    <version>4.5.0.4-4.5.0-0</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>
  <modelVersion>4.0.0</modelVersion>
  <artifactId>impala-arrow-flight</artifactId>
  <packaging>jar</packaging>

  <properties>
    <arrow.version>16.0.0</arrow.version>
    <shaded.prefix>org.apache.impala.shaded.flight</shaded.prefix>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.apache.arrow</groupId>
      <artifactId>flight-sql</artifactId>
      <version>${arrow.version}</version>
    </dependency>
    <!-- netty's SslHandler references io.netty.channel.unix classes; not pulled in
         transitively, without it every TLS connection is closed during channel setup.
         Only the Java classes are used (META-INF/native is filtered out below). -->
    <dependency>
      <groupId>io.netty</groupId>
      <artifactId>netty-transport-native-unix-common</artifactId>
      <version>4.1.108.Final</version>
    </dependency>
    <!-- allocation manager for RootAllocator (Flight itself uses netty buffers) -->
    <dependency>
      <groupId>org.apache.arrow</groupId>
      <artifactId>arrow-memory-netty</artifactId>
      <version>${arrow.version}</version>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.5.1</version>
        <configuration>
          <createDependencyReducedPom>true</createDependencyReducedPom>
          <artifactSet>
            <excludes>
              <!-- provided by the impalad classpath -->
              <exclude>org.slf4j:*</exclude>
              <!-- BoringSSL natives; the JDK SSL provider is used instead -->
              <exclude>io.netty:netty-tcnative-boringssl-static</exclude>
              <exclude>io.netty:netty-tcnative-classes</exclude>
              <!-- annotation-only artifacts -->
              <exclude>com.google.code.findbugs:jsr305</exclude>
              <exclude>com.google.errorprone:error_prone_annotations</exclude>
              <exclude>com.google.j2objc:j2objc-annotations</exclude>
              <exclude>com.google.android:annotations</exclude>
              <exclude>org.checkerframework:checker-qual</exclude>
              <exclude>org.codehaus.mojo:animal-sniffer-annotations</exclude>
              <exclude>javax.annotation:javax.annotation-api</exclude>
            </excludes>
          </artifactSet>
          <relocations>
            <relocation>
              <pattern>io.grpc</pattern>
              <shadedPattern>${shaded.prefix}.io.grpc</shadedPattern>
            </relocation>
            <relocation>
              <pattern>io.netty</pattern>
              <shadedPattern>${shaded.prefix}.io.netty</shadedPattern>
            </relocation>
            <relocation>
              <pattern>io.perfmark</pattern>
              <shadedPattern>${shaded.prefix}.io.perfmark</shadedPattern>
            </relocation>
            <relocation>
              <pattern>com.google</pattern>
              <shadedPattern>${shaded.prefix}.com.google</shadedPattern>
            </relocation>
            <relocation>
              <pattern>com.fasterxml.jackson</pattern>
              <shadedPattern>${shaded.prefix}.com.fasterxml.jackson</shadedPattern>
            </relocation>
            <relocation>
              <pattern>org.apache.commons.codec</pattern>
              <shadedPattern>${shaded.prefix}.org.apache.commons.codec</shadedPattern>
            </relocation>
            <relocation>
              <pattern>net.bytebuddy</pattern>
              <shadedPattern>${shaded.prefix}.net.bytebuddy</shadedPattern>
            </relocation>
          </relocations>
          <transformers>
            <!-- gRPC finds name resolvers, load balancers and transports via ServiceLoader -->
            <transformer
                implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
          </transformers>
          <filters>
            <filter>
              <artifact>*:*</artifact>
              <excludes>
                <exclude>META-INF/*.SF</exclude>
                <exclude>META-INF/*.DSA</exclude>
                <exclude>META-INF/*.RSA</exclude>
                <exclude>META-INF/versions/*/module-info.class</exclude>
                <exclude>module-info.class</exclude>
                <exclude>META-INF/native/**</exclude>
                <exclude>META-INF/native-image/**</exclude>
                <exclude>**/*.proto</exclude>
              </excludes>
            </filter>
          </filters>
        </configuration>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
