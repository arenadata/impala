---- HIVE_QUERY
# Impala cannot write TIMESTAMPTZ columns. The two values fall on the same local time
# in Europe/Budapest: the end of summer time repeats the hour from 02:00.
use $DATABASE;
CREATE TABLE ice_puffin_tstz (i int, ts TIMESTAMP WITH LOCAL TIME ZONE)
STORED BY ICEBERG;
INSERT INTO ice_puffin_tstz VALUES
    (1, CAST('2021-10-31 00:15:00 UTC' AS TIMESTAMP WITH LOCAL TIME ZONE)),
    (2, CAST('2021-10-31 01:15:00 UTC' AS TIMESTAMP WITH LOCAL TIME ZONE));
====
---- QUERY
SET TIMEZONE='Europe/Budapest';
invalidate metadata ice_puffin_tstz;
select count(distinct ts) from ice_puffin_tstz;
---- RESULTS
1
---- TYPES
BIGINT
====
---- QUERY
# COMPUTE STATS hashes TIMESTAMPTZ values for the sketches in UTC, whatever the session
# time zone is: the values stay distinct.
SET TIMEZONE='Europe/Budapest';
compute stats ice_puffin_tstz;
show column stats ice_puffin_tstz;
---- RESULTS
'i','INT',2,0,4,4,-1,-1
'ts','TIMESTAMP',2,0,16,16,-1,-1
---- TYPES
STRING, STRING, BIGINT, BIGINT, BIGINT, DOUBLE, BIGINT, BIGINT
====
---- QUERY
describe formatted ice_puffin_tstz;
---- RESULTS: VERIFY_IS_SUBSET
row_regex:'','impala.computeStatsSnapshotIds','1-2:(\d+)\s*'
---- TYPES
STRING,STRING,STRING
====
---- QUERY
# The column stats child query returns the theta sketches of all columns in one row. With
# 80 columns of more than 4096 distinct values the row is larger than the largest page of
# the result spooling buffer; the result of a statement that returns one row is not
# spooled.
create table ice_puffin_wide stored as iceberg as
select id c0, id + 1 c1, id + 2 c2, id + 3 c3, id + 4 c4, id + 5 c5, id + 6 c6,
