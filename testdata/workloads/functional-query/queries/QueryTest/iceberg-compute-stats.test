====

---- QUERY
# Tests for 'impala.computeStatsSnapshotIds'.
create table test_ice (
  i INT,
  b BIGINT,
  s STRING
) stored as iceberg;
compute stats test_ice;
describe formatted test_ice;
---- RESULTS: VERIFY_IS_SUBSET
# For a table that contains no snapshot, the snapshot ids are -1.
row_regex:'','impala.computeStatsSnapshotIds','1-3:-1\s*'
---- TYPES
STRING,STRING,STRING
====
---- QUERY
# Create a new snapshot, compute stats, and verify that the snapshot id is the same for
# all columns.
insert into test_ice values (1, 1, "one"), (1, 2, "two");
compute stats test_ice;
describe formatted test_ice;
---- RESULTS: VERIFY_IS_SUBSET
row_regex:'','impala.computeStatsSnapshotIds','1-3:(\d+)\s*'
---- TYPES
STRING,STRING,STRING
====
---- QUERY
# Compute stats for only the first and third columns, verify that they have the same
# snapshot id.
insert into test_ice values (10, 10, "ten");
compute stats test_ice(i, s);
describe formatted test_ice;
---- RESULTS: VERIFY_IS_SUBSET
row_regex:'','impala.computeStatsSnapshotIds','1:(\d+),2:(\d+),3:\1\s*'
---- TYPES
STRING,STRING,STRING
====
---- QUERY
# Compute stats for only the second and third columns, verify that they have the same
# snapshot id.
insert into test_ice values (100, 100, "hundred");
compute stats test_ice(b, s);
describe formatted test_ice;
---- RESULTS: VERIFY_IS_SUBSET
row_regex:'','impala.computeStatsSnapshotIds','1:(\d+),2-3:(\d+)\s*'
---- TYPES
STRING,STRING,STRING
====
---- QUERY
drop stats test_ice;
describe formatted test_ice;
---- RESULTS: VERIFY_IS_NOT_IN
row_regex:'','impala.computeStatsSnapshotIds','.*'
---- TYPES
STRING,STRING,STRING
====
---- QUERY
# Tests for Puffin NDV statistics written by COMPUTE STATS.
# COMPUTE STATS writes theta sketches of the current snapshot to a Puffin file. The NDV
# in HMS is the estimate of the sketch: exact for small sets, nulls are not counted.
create table ice_puffin (i int, s string, d date) stored as iceberg;
insert into ice_puffin values (1, 'a', '2024-01-01'), (2, 'b', '2024-01-01'),
    (2, 'c', NULL);
compute stats ice_puffin;
show column stats ice_puffin;
---- RESULTS
'i','INT',2,0,4,4,-1,-1
's','STRING',3,0,1,1,-1,-1
'd','DATE',1,1,4,4,-1,-1
---- TYPES
STRING, STRING, BIGINT, BIGINT, BIGINT, DOUBLE, BIGINT, BIGINT
====
---- QUERY
describe formatted ice_puffin;
---- RESULTS: VERIFY_IS_SUBSET
row_regex:'','impala.computeStatsSnapshotIds','1-3:(\d+)\s*'
---- TYPES
STRING,STRING,STRING
====
---- QUERY
# The snapshot ids with Puffin statistics make an incremental base.
show table stats ice_puffin
---- LABELS
#ROWS, #Files, Size, Bytes Cached, Cache Replication, Format, Incremental stats, Location, EC Policy
---- RESULTS: VERIFY_IS_EQUAL
3,1,regex:'.*B','NOT CACHED','NOT CACHED','PARQUET','true','$NAMENODE/test-warehouse/$DATABASE.db/ice_puffin','$ERASURECODE_POLICY'
---- TYPES
BIGINT,BIGINT,STRING,STRING,STRING,STRING,STRING,STRING,STRING
====
---- QUERY
# With 'impala.iceberg_write_puffin_stats'='false' COMPUTE STATS computes NDV() without
# Puffin statistics. The snapshot ids are still written, but they make no incremental
# base.
alter table ice_puffin set tblproperties('impala.iceberg_write_puffin_stats'='false');
insert into ice_puffin values (3, 'd', '2024-01-02');
compute stats ice_puffin;
show column stats ice_puffin;
---- RESULTS
'i','INT',3,0,4,4,-1,-1
's','STRING',4,0,1,1,-1,-1
'd','DATE',2,1,4,4,-1,-1
---- TYPES
STRING, STRING, BIGINT, BIGINT, BIGINT, DOUBLE, BIGINT, BIGINT
====
---- QUERY
describe formatted ice_puffin;
---- RESULTS: VERIFY_IS_SUBSET
row_regex:'','impala.computeStatsSnapshotIds','1-3:(\d+)\s*'
---- TYPES
STRING,STRING,STRING
====
---- QUERY
show table stats ice_puffin
---- LABELS
#ROWS, #Files, Size, Bytes Cached, Cache Replication, Format, Incremental stats, Location, EC Policy
---- RESULTS: VERIFY_IS_EQUAL
4,2,regex:'.*B','NOT CACHED','NOT CACHED','PARQUET','false','$NAMENODE/test-warehouse/$DATABASE.db/ice_puffin','$ERASURECODE_POLICY'
---- TYPES
BIGINT,BIGINT,STRING,STRING,STRING,STRING,STRING,STRING,STRING
