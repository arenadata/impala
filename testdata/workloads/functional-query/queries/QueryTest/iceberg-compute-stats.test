'p_bigint','BIGINT',1,0,8,8,-1,-1
'p_float','FLOAT',1,0,4,4,-1,-1
'p_double','DOUBLE',1,0,8,8,-1,-1
'p_decimal','DECIMAL(6,3)',1,0,4,4,-1,-1
'p_date','DATE',1,0,4,4,-1,-1
